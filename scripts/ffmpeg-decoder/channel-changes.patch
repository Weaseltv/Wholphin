 /**
+ * The resampler and the PCM format it produces, kept in AVCodecContext.opaque.
+ *
+ * The output format is fixed by the first decoded frame, because that is what
+ * the Java decoder reports to the AudioSink. Broadcast AC-3 and E-AC-3 often
+ * change channel count mid-stream (5.1 to 2.0 at an ad break), so whenever a
+ * frame's input format differs from the resampler's, the resampler is rebuilt
+ * from that frame and mixes it to the fixed output. Upstream builds it once from
+ * the first frame, and swr_convert then reads channel planes a 2.0 frame does
+ * not have (SIGSEGV in swri_oldapi_conv_fltp_to_s16_nch_neon).
+ */
+struct ResampleState {
+  SwrContext* swrContext;
+  AVChannelLayout inLayout;
+  AVSampleFormat inFormat;
+  int inSampleRate;
+  AVChannelLayout outLayout;
+  int outSampleRate;
+};
+
+/**
+ * Returns the resampler state for the frame, creating or rebuilding the
+ * resampler if the frame's format differs from the one it was built for.
+ * Returns NULL on failure.
+ */
+ResampleState* getResampleState(AVCodecContext* context, AVFrame* frame);
+
+/**
+ * Releases the resampler state kept in the context, if any.
+ */
+void releaseResampleState(AVCodecContext* context);
+
