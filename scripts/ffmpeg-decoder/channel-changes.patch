+/**
+ * The frame's channel layout, or the context's if the frame does not set one.
+ */
+static const AVChannelLayout* frameLayout(AVCodecContext* context,
+                                          AVFrame* frame) {
+  return frame->ch_layout.nb_channels > 0 ? &frame->ch_layout
+                                          : &context->ch_layout;
+}
+
+ResampleState* getResampleState(AVCodecContext* context, AVFrame* frame) {
+  const AVChannelLayout* inLayout = frameLayout(context, frame);
+  AVSampleFormat inFormat = frame->format >= 0
+                                ? static_cast<AVSampleFormat>(frame->format)
+                                : context->sample_fmt;
+  int inSampleRate =
+      frame->sample_rate > 0 ? frame->sample_rate : context->sample_rate;
+
+  ResampleState* state = static_cast<ResampleState*>(context->opaque);
+  if (!state) {
+    state = static_cast<ResampleState*>(av_mallocz(sizeof(ResampleState)));
+    if (!state) {
+      LOGE("Failed to allocate resampler state.");
+      return NULL;
+    }
+    if (av_channel_layout_copy(&state->outLayout, inLayout) < 0) {
+      LOGE("Failed to copy the output channel layout.");
+      av_free(state);
+      return NULL;
+    }
+    state->outSampleRate = inSampleRate;
+    context->opaque = state;
+  } else if (state->swrContext &&
+             av_channel_layout_compare(&state->inLayout, inLayout) == 0 &&
+             state->inFormat == inFormat &&
+             state->inSampleRate == inSampleRate) {
+    return state;
+  } else {
+    LOGD("Input changed to %d channels at %d Hz, mixing to %d channels at %d Hz.",
+         inLayout->nb_channels, inSampleRate, state->outLayout.nb_channels,
+         state->outSampleRate);
+  }
+
+  swr_free(&state->swrContext);
+  av_channel_layout_uninit(&state->inLayout);
+  int result = swr_alloc_set_opts2(&state->swrContext,          // ps
+                                   &state->outLayout,           // out_ch_layout
+                                   context->request_sample_fmt, // out_sample_fmt
+                                   state->outSampleRate,        // out_sample_rate
+                                   inLayout,                    // in_ch_layout
+                                   inFormat,                    // in_sample_fmt
+                                   inSampleRate,                // in_sample_rate
+                                   0,                           // log_offset
+                                   NULL                         // log_ctx
+  );
+  if (result < 0) {
+    logError("swr_alloc_set_opts2", result);
+    return NULL;
+  }
+  result = swr_init(state->swrContext);
+  if (result < 0) {
+    logError("swr_init", result);
+    swr_free(&state->swrContext);
+    return NULL;
+  }
+  result = av_channel_layout_copy(&state->inLayout, inLayout);
+  if (result < 0) {
+    logError("av_channel_layout_copy", result);
+    swr_free(&state->swrContext);
+    return NULL;
+  }
+  state->inFormat = inFormat;
+  state->inSampleRate = inSampleRate;
+  return state;
+}
+
+void releaseResampleState(AVCodecContext* context) {
+  ResampleState* state = static_cast<ResampleState*>(context->opaque);
+  if (!state) {
+    return;
+  }
+  swr_free(&state->swrContext);
+  av_channel_layout_uninit(&state->inLayout);
+  av_channel_layout_uninit(&state->outLayout);
+  av_free(state);
+  context->opaque = NULL;
+}
+
 int transformError(int errorNumber) {
   return errorNumber == AVERROR_INVALIDDATA ? AUDIO_DECODER_ERROR_INVALID_DATA
                                             : AUDIO_DECODER_ERROR_OTHER;
