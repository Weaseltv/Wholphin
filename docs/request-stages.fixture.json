{
  "version": 1,
  "cases": [
    {
      "name": "empty_queue",
      "request": {
        "id": 1,
        "status": 2,
        "type": "movie",
        "media": {
          "status": 3,
          "downloadStatus": []
        }
      },
      "expectedKind": "WAITING_LIBRARY"
    },
    {
      "name": "completed_not_ready",
      "request": {
        "id": 2,
        "status": 2,
        "type": "movie",
        "media": {
          "status": 3,
          "downloadStatus": [
            {
              "status": "completed",
              "size": 100,
              "sizeLeft": 0
            }
          ]
        }
      },
      "expectedKind": "ADDING"
    },
    {
      "name": "movie_progress",
      "request": {
        "id": 3,
        "status": 2,
        "type": "movie",
        "media": {
          "status": 3,
          "downloadStatus": [
            {
              "status": "downloading",
              "size": 100,
              "sizeLeft": 58
            }
          ]
        }
      },
      "expectedKind": "DOWNLOADING"
    },
    {
      "name": "invalid_bytes",
      "request": {
        "id": 4,
        "status": 2,
        "type": "movie",
        "media": {
          "status": 3,
          "downloadStatus": [
            {
              "status": "downloading",
              "size": 0,
              "sizeLeft": -1
            }
          ]
        }
      },
      "expectedKind": "CHECKING"
    },
    {
      "name": "unknown_queue_status",
      "request": {
        "id": 5,
        "status": 2,
        "type": "movie",
        "media": {
          "status": 3,
          "downloadStatus": [
            {
              "status": "new-status",
              "size": 100,
              "sizeLeft": 50
            }
          ]
        }
      },
      "expectedKind": "CHECKING"
    },
    {
      "name": "empty_tv_seasons",
      "request": {
        "id": 6,
        "status": 2,
        "type": "tv",
        "media": {
          "status": 5
        },
        "seasons": []
      },
      "expectedKind": "CHECKING"
    },
    {
      "name": "pending_tv_unknown",
      "request": {
        "id": 7,
        "status": 1,
        "type": "tv",
        "media": {},
        "seasons": []
      },
      "expectedKind": "WAITING_APPROVAL"
    },
    {
      "name": "tv_partial",
      "request": {
        "id": 8,
        "status": 2,
        "type": "tv",
        "seasons": [
          {
            "seasonNumber": 1
          },
          {
            "seasonNumber": 2
          }
        ],
        "media": {
          "status": 4,
          "seasons": [
            {
              "seasonNumber": 1,
              "status": 5
            },
            {
              "seasonNumber": 2,
              "status": 4
            }
          ]
        }
      },
      "expectedKind": "PARTIAL"
    },
    {
      "name": "tv_4k_requires_4k",
      "request": {
        "id": 9,
        "status": 2,
        "type": "tv",
        "is4k": true,
        "seasons": [
          {
            "seasonNumber": 1
          }
        ],
        "media": {
          "status": 5,
          "status4k": 3,
          "seasons": [
            {
              "seasonNumber": 1,
              "status": 5,
              "status4k": 3
            }
          ]
        }
      },
      "expectedKind": "WAITING_LIBRARY"
    },
    {
      "name": "movie_ready",
      "request": {
        "id": 10,
        "status": 5,
        "type": "movie",
        "media": {
          "status": 5
        }
      },
      "expectedKind": "READY"
    },
    {
      "name": "failed",
      "request": {
        "id": 11,
        "status": 4,
        "type": "movie",
        "media": {
          "status": 3
        }
      },
      "expectedKind": "FAILED"
    }
  ],
  "eventExamples": [
    {
      "sequence": [
        "failed",
        "ready"
      ],
      "keys": [
        "v1|11|hd|failed|-",
        "v1|11|hd|ready|-"
      ]
    },
    {
      "sequence": [
        "partial",
        "partial",
        "ready"
      ],
      "keys": [
        "v1|8|hd|partial|1:P",
        "v1|8|hd|partial|1:A",
        "v1|8|hd|ready|-"
      ]
    }
  ],
  "phoneHandoff": [
    "push-before-poll and poll-before-push must share one presentation key (phase 3+)"
  ]
}
