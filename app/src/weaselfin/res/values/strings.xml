<?xml version="1.0" encoding="utf-8"?>
<!-- WeaselFin overrides. Flavor source set, so app/src/main is untouched and
     rebases against upstream stay clean. D-1: the name is WeaselFin, never
     "WeaselTV" - the IPTV app owns that tile name on the launcher. -->
<resources>
    <string name="app_name" translatable="false">WeaselFin</string>
    <string name="app_name_long" translatable="false">WeaselFin</string>

    <!-- Upstream leaks its own product name into user-visible copy. These are the
         places it actually shows: the display-preset picker in Settings, and the
         toast shown immediately after every update. -->
    <string name="display_preset_default">WeaselFin Default</string>
    <string name="display_preset_compact">WeaselFin Compact</string>
    <string name="updated_toast">WeaselFin updated to %s</string>
    <!-- Nav rail renames, owner-approved 2026-08-19.

         "Discover" -> "Requests": the tab opens Seerr, so the old name described the
         browsing rather than the thing customers actually do there.

         "Favorites" -> "Watchlist": migrating Plex users already know this word for
         exactly this behaviour - mark something already in the library that you intend
         to watch later, then open the list on movie night. "Favorites" invites a
         different reading ("things I loved").

         NOTE: `discovered_servers` is deliberately NOT changed - that is server
         discovery on the sign-in screen and has nothing to do with this tab. -->
    <string name="discover">Requests</string>
    <string name="discover_tv">Request TV Shows</string>
    <string name="discover_movies">Request Movies</string>

    <string name="favorites">Watchlist</string>
    <string name="add_favorite">Add to Watchlist</string>
    <string name="remove_favorite">Remove from Watchlist</string>
    <string name="favorite_items_title">Watchlist %s</string>
</resources>
